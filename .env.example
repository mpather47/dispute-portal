# Copy this file to .env and fill in real values before running docker-compose.
# Never commit .env to source control.

# SQL Server SA password — must meet SQL Server complexity requirements
MSSQL_SA_PASSWORD=ChangeMe!Strong_Password_Here

# JWT signing key — generate with: openssl rand -base64 32
JWT_KEY=replace-with-a-secure-random-256-bit-key-base64-encoded

# Comma-separated list of allowed frontend origins (no trailing slashes)
ALLOWED_ORIGINS=https://your-frontend-domain.com
